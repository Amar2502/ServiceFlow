generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoutingMode {
  DEPARTMENT
  EMPLOYEE
}

enum Role {
  ADMIN
  AGENT
}

enum ComplaintStatus {
  open
  in_progress
  resolved
}

enum AssigneeType {
  EMPLOYEE
  DEPARTMENT
}

model Tenant {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  routingMode RoutingMode @default(DEPARTMENT) @map("routing_mode")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp(6)

  users       User[]
  apiKeys     ApiKey[]
  departments Department[]
  employees   Employee[]
  complaints  Complaint[]
  assignments Assignment[]
  invites     Invite[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  name         String?
  email        String
  passwordHash String     @map("password_hash")
  role         Role       @default(ADMIN)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, email])
  @@index([tenantId], map: "idx_users_tenant_id")
  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  keyHash    String    @map("key_hash")
  name       String?
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, keyHash])
  @@index([tenantId], map: "idx_api_keys_tenant_id")
  @@map("api_keys")
}

model Department {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  keywords  String[]
  vector    Json?     @db.JsonB
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees   Employee[]
  assignments Assignment[]

  @@unique([tenantId, name])
  @@index([tenantId], map: "idx_departments_tenant_id")
  @@index([deletedAt], map: "idx_departments_deleted_at")
  @@map("departments")
}

model Employee {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  departmentId String?     @map("department_id") @db.Uuid
  load         Int         @default(0)
  name         String?
  title        String?
  keywords     String[]
  vector       Json?       @db.JsonB
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamp(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments Assignment[]

  @@unique([tenantId, userId])
  @@index([tenantId], map: "idx_employees_tenant_id")
  @@index([userId], map: "idx_employees_user_id")
  @@index([departmentId], map: "idx_employees_department_id")
  @@index([deletedAt], map: "idx_employees_deleted_at")
  @@map("employees")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Sentiment {
  HAPPY
  NEUTRAL
  FRUSTRATED
  ANGRY
}

model Complaint {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  title                 String
  description           String?
  customerName          String?         @map("customer_name")
  customerEmail         String?         @map("customer_email")
  externalReferenceId   String?         @map("external_reference_id")
  status                ComplaintStatus @default(open)
  priority              Priority        @default(MEDIUM)
  sentiment             Sentiment       @default(NEUTRAL)
  summary               String?         @db.Text
  suggestedReply        String?         @map("suggested_reply") @db.Text
  aiReasoning           String?         @map("ai_reasoning") @db.Text
  aiConfidence          Float?          @map("ai_confidence")
  slaDueAt              DateTime?       @map("sla_due_at") @db.Timestamp(6)
  isSlaBreached         Boolean         @default(false) @map("is_sla_breached")
  isCorrectlyClassified Boolean         @default(false) @map("is_correctly_classified")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt             DateTime?       @map("deleted_at") @db.Timestamp(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@index([tenantId], map: "idx_complaints_tenant_id")
  @@index([status], map: "idx_complaints_status")
  @@index([slaDueAt], map: "idx_complaints_sla_due_at")
  @@index([isSlaBreached], map: "idx_complaints_is_sla_breached")
  @@index([deletedAt], map: "idx_complaints_deleted_at")
  @@map("complaints")
}

model Assignment {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  complaintId  String       @map("complaint_id") @db.Uuid
  assigneeType AssigneeType @map("assignee_type")
  employeeId   String?      @map("employee_id") @db.Uuid
  departmentId String?      @map("department_id") @db.Uuid
  assignedAt   DateTime     @default(now()) @map("assigned_at") @db.Timestamp(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complaint  Complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  employee   Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([tenantId], map: "idx_assignments_tenant_id")
  @@index([complaintId], map: "idx_assignments_complaint_id")
  @@index([employeeId], map: "idx_assignments_employee")
  @@index([departmentId], map: "idx_assignments_department")
  @@map("assignments")
}

model Invite {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  role      Role     @default(AGENT)
  token     String   @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_invites_tenant_id")
  @@index([token], map: "idx_invites_token")
  @@map("invites")
}